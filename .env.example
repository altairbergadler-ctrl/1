# --- Core ---
DATABASE_URL=postgresql+psycopg2://music:music@db:5432/music
REDIS_URL=redis://redis:6379/0
MUSIC_LIBRARY_PATH=/music/library
MUSIC_LIBRARY_HOST_PATH=./data/music
APP_AUTH_TOKEN=
TZ=Europe/Moscow
AUTH_COOKIE_MAX_AGE_SECONDS=2592000
# Set true only when the PWA is served over HTTPS.
AUTH_COOKIE_SECURE=false

# --- MusicBrainz (include a real maintainer email or URL) ---
MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_USER_AGENT=MusicServiceMVP/0.2 (your-email-or-url)
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_CACHE_TTL_SECONDS=2592000
MUSICBRAINZ_NEGATIVE_CACHE_TTL_SECONDS=86400
MUSICBRAINZ_RATE_LIMIT_SECONDS=1.0

# Local/tests only. Keep false when a Celery worker is running.
CELERY_TASK_ALWAYS_EAGER=false
CELERY_VISIBILITY_TIMEOUT_SECONDS=86400
SCAN_JOB_STALE_SECONDS=21600
PLAYLIST_IMPORT_JOB_STALE_SECONDS=21600
MATCHING_JOB_STALE_SECONDS=21600

# --- Spotify (developer.spotify.com -> Create App) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/sources/spotify/callback
SPOTIFY_OAUTH_STATE_TTL_SECONDS=600

# --- Yandex Music ---
YANDEX_TOKEN=
# Lossless acquisition uses an isolated, internal signing sidecar pinned to a
# reviewed upstream commit. Keep disabled until the account and token are ready.
# The worker prefers FLAC (native or FLAC-in-MP4 remuxed without encoding),
# then stores the best AAC/MP3 variant returned by Yandex without transcoding.
YANDEX_DOWNLOAD_ENABLED=false
YANDEX_SIGNER_URL=http://yandex-signer:8091
# Separate random internal secret, minimum 16 characters. It is not a Yandex
# account credential and must not reuse APP_AUTH_TOKEN.
YANDEX_INTERNAL_TOKEN=
YANDEX_STAGING_PATH=/music/staging/yandex
YANDEX_MAX_TRACKS_PER_RUN=25
YANDEX_REQUEST_DELAY_SECONDS=1.0
YANDEX_BATCH_DELAY_SECONDS=30
YANDEX_DOWNLOAD_JOB_STALE_SECONDS=21600
YANDEX_CONNECT_TIMEOUT_SECONDS=10
YANDEX_READ_TIMEOUT_SECONDS=300
YANDEX_MAX_FILE_BYTES=536870912

# --- Qobuz (RESTRICT: docs/qobuz-dl-assessment.md) ---
# Требуется активная платная подписка Qobuz Studio. Provider credentials
# передаются только изолированному qobuz-sidecar: backend/worker получают
# лишь отдельный внутренний control token. Sidecar видит только staging и
# выходит в интернет через allowlisting proxy. Ограничения и риски —
# docs/qobuz-dl-assessment.md (раздел 7).
QOBUZ_ENABLED=false
# Авторизация только токеном браузерной сессии: пароль аккаунта стороннему коду
# не передаётся. Как получить токен: войти на play.qobuz.com в браузере →
# DevTools → Application → Local Storage → ключ localuser → поля token и id.
# Если connect/search внезапно начнут отвечать 400/401 — токен протух,
# повторите извлечение и обновите значения ниже.
QOBUZ_AUTH_TOKEN=
QOBUZ_USER_ID=
# Отдельный случайный секрет (не APP_AUTH_TOKEN), минимум 32 символа. Он
# защищает внутренний API sidecar и не даёт доступ к аккаунту Qobuz напрямую.
QOBUZ_INTERNAL_TOKEN=
# 6=16/44.1, 7=24/<96kHz, 27=24/>96kHz; MP3 tier 5 запрещён
QOBUZ_QUALITY=27
QOBUZ_STAGING_PATH=/music/staging
QOBUZ_STAGING_HOST_PATH=./data/qobuz-staging
QOBUZ_MAX_TRACKS_PER_RUN=25
QOBUZ_REQUEST_DELAY_SECONDS=1.0
QOBUZ_BATCH_DELAY_SECONDS=30
QOBUZ_DOWNLOAD_JOB_STALE_SECONDS=21600
QOBUZ_EMBED_ART=true
QOBUZ_CONNECT_TIMEOUT_SECONDS=10
QOBUZ_READ_TIMEOUT_SECONDS=120
# Жёсткий лимит одного файла (4 GiB), защищает staging от переполнения.
QOBUZ_MAX_FILE_BYTES=4294967296

# --- Postgres container ---
POSTGRES_USER=music
POSTGRES_PASSWORD=music
POSTGRES_DB=music
