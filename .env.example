# --- Core ---
DATABASE_URL=postgresql+psycopg2://music:music@db:5432/music
REDIS_URL=redis://redis:6379/0
MUSIC_LIBRARY_PATH=/music/library
MUSIC_LIBRARY_HOST_PATH=./data/music
APP_AUTH_TOKEN=
TZ=Europe/Moscow
AUTH_COOKIE_MAX_AGE_SECONDS=2592000
# Set true only when the PWA is served over HTTPS.
AUTH_COOKIE_SECURE=false

# --- MusicBrainz (include a real maintainer email or URL) ---
MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_USER_AGENT=MusicServiceMVP/0.2 (your-email-or-url)
MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
MUSICBRAINZ_CACHE_TTL_SECONDS=2592000
MUSICBRAINZ_NEGATIVE_CACHE_TTL_SECONDS=86400
MUSICBRAINZ_RATE_LIMIT_SECONDS=1.0

# Local/tests only. Keep false when a Celery worker is running.
CELERY_TASK_ALWAYS_EAGER=false
CELERY_VISIBILITY_TIMEOUT_SECONDS=86400
SCAN_JOB_STALE_SECONDS=21600
PLAYLIST_IMPORT_JOB_STALE_SECONDS=21600
MATCHING_JOB_STALE_SECONDS=21600

# --- Spotify (developer.spotify.com -> Create App) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/sources/spotify/callback
SPOTIFY_OAUTH_STATE_TTL_SECONDS=600

# --- Yandex Music ---
YANDEX_TOKEN=

# --- Qobuz (RESTRICT: docs/qobuz-dl-assessment.md) ---
# Требуется активная платная подписка Qobuz Studio. Учётные данные живут только
# в этом файле: в БД не сохраняются, API их не возвращает, наружу уходит лишь
# MD5 пароля по HTTPS. Скачивание идёт только в staging; в библиотеку файлы
# переносит worker после верификации. Ограничения и риски —
# docs/qobuz-dl-assessment.md (раздел 7).
QOBUZ_ENABLED=false
QOBUZ_EMAIL=
QOBUZ_PASSWORD=
# 5=MP3, 6=16/44.1, 7=24/<96kHz, 27=24/>96kHz (с fallback на доступное)
QOBUZ_QUALITY=27
QOBUZ_STAGING_PATH=/music/staging
QOBUZ_STAGING_HOST_PATH=./data/qobuz-staging
QOBUZ_MAX_TRACKS_PER_RUN=25
QOBUZ_REQUEST_DELAY_SECONDS=1.0
QOBUZ_DOWNLOAD_JOB_STALE_SECONDS=21600
QOBUZ_EMBED_ART=true

# --- Postgres container ---
POSTGRES_USER=music
POSTGRES_PASSWORD=music
POSTGRES_DB=music
