{
	admin 127.0.0.1:2019
	log default {
		format filter {
			request>uri query {
				replace apiKey REDACTED
				replace apikey REDACTED
				replace u REDACTED
				replace p REDACTED
				replace t REDACTED
				replace s REDACTED
				replace code REDACTED
				replace state REDACTED
				replace id_token REDACTED
				replace access_token REDACTED
			}
		}
	}
}

audiofeel.su {
	encode zstd gzip
	# OpenSubsonic bearer keys are query parameters by protocol. Disable this
	# site's access log entirely so no future formatter can persist them.
	log {
		output discard
	}

	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:18000
	}

	@opensubsonic path /rest/*
	handle @opensubsonic {
		reverse_proxy 127.0.0.1:18000
	}

	handle {
		reverse_proxy 127.0.0.1:18080
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

www.audiofeel.su {
	redir https://audiofeel.su{uri} permanent
}
